{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bemoshiur/OmniRank/main/schemas/omnirank.config.schema.json",
  "title": "OmniRank site configuration",
  "type": "object",
  "required": ["site"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "site": {
      "type": "object",
      "required": ["name", "url", "entityType"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "legalName": { "type": "string" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "entityType": {
          "enum": ["Organization", "LocalBusiness", "ProfessionalService",
                   "NewsMediaOrganization", "SoftwareApplication",
                   "EducationalOrganization", "MedicalOrganization"]
        },
        "parentOrganization": { "type": "string" },
        "locales": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "path"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string" },
              "path": { "type": "string" },
              "default": { "type": "boolean" }
            }
          }
        }
      }
    },
    "nap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "street": { "type": "string" }, "city": { "type": "string" },
        "region": { "type": "string" }, "postalCode": { "type": "string" },
        "country": { "type": "string" }, "phone": { "type": "string" },
        "email": { "type": "string" },
        "geo": {
          "type": "object",
          "required": ["lat", "lng"],
          "additionalProperties": false,
          "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } }
        },
        "openingHours": { "type": "array", "items": { "type": "string" } }
      }
    },
    "identifiers": { "type": "object", "additionalProperties": { "type": "string" } },
    "sameAs": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"] }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framework": {
          "enum": ["next-app-router", "next-pages", "next-pages-router", "astro",
                   "nuxt", "sveltekit", "wordpress", "jekyll", "hugo", "eleventy",
                   "shopify", "static", "other"],
          "description": "Routing convention. `next-pages` is the historical spelling of `next-pages-router` and both remain valid. `shopify` and `other` have no locator implementation, so findings on those projects are display-only. omnirank fix detects this from disk when it is unset."
        },
        "srcDir": { "type": "string" },
        "publicDir": { "type": "string" },
        "builtHtml": { "type": "string" }
      }
    },
    "crawlers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowAI": { "type": "boolean" },
        "disallow": { "type": "array", "items": { "type": "string" } }
      }
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "license": {
          "type": ["string", "null"],
          "description": "Content reuse licence to state in llms.txt/llms-full.txt and facts.json (e.g. \"CC-BY-4.0\"). Absent: `omnirank geo` grants no reuse rights (same as \"none\" below) and prints a one-line stderr notice naming this key, so the choice isn't made silently. Set to a real licence string to grant reuse rights. Set to the string \"none\" (or JSON null) to state the no-grant choice explicitly and silence the notice -- functionally identical to leaving it unset, but a deliberate record of the choice."
        },
        "attribution": { "type": "string" },
        "answerBlockSelector": { "type": "string" }
      }
    },
    "aeo": {
      "type": "object",
      "additionalProperties": false,
      "description": "AnswerBlock sizing. The default 40-60 word band is calibrated for space-delimited Latin script; scripts without word separators need character counting.",
      "properties": {
        "answerBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default"],
          "properties": {
            "default": { "$ref": "#/$defs/band" },
            "byScript": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/band" },
              "description": "Override per script family: latin, cjk, brahmic, arabic, cyrillic."
            }
          }
        }
      }
    },
    "indexing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "indexnowKeyFile": { "type": "string" },
        "gscProperty": { "type": "string" },
        "bing": { "type": "boolean" },
        "wayback": { "type": "boolean" },
        "priorityUrls": { "type": "string" }
      }
    },
    "tracking": { "type": "object", "additionalProperties": { "type": "string" } },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sampleSize": { "type": "integer", "minimum": 0 },
        "failOn": {
          "type": "array",
          "items": {
            "enum": ["h1", "canonical", "title-length", "description-length", "hreflang",
                     "og", "image-dims", "answer-block", "faq", "speakable",
                     "llms-txt", "llms-full", "facts-json", "ai-allowlist",
                     "citation-licence", "sitemap-health",
                     "lastmod-inflation", "schema", "schema-fabrication",
                     "duplicate-title", "duplicate-description", "noindex-in-sitemap",
                     "canonical-cluster", "hreflang-reciprocity",
                     "response-time", "page-weight", "compression", "render-blocking"]
          }
        }
      }
    },
    "smm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "items": { "enum": ["facebook", "instagram", "x", "linkedin", "youtube"] }
        },
        "queueDir": { "type": "string" },
        "requireHumanApproval": { "type": "boolean" }
      }
    },
    "competitors": { "type": "array", "items": { "type": "string" } },
    "statistics": {
      "type": "array",
      "description": "First-party benchmarks. Only entries with published:true are emitted to facts.json.",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "unit": { "type": "string" },
          "sampleSize": { "type": "integer", "minimum": 0 },
          "methodology": { "type": "string" },
          "asOf": { "type": "string" },
          "source": { "type": "string" },
          "published": {
            "type": "boolean",
            "description": "Real-only gate. Absent or false means the statistic renders nowhere."
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^env:[A-Z_][A-Z0-9_]*$",
        "description": "Must be an env: pointer. Literal secrets are rejected by design."
      }
    }
  },
  "$defs": {
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "min", "max"],
      "properties": {
        "unit": { "enum": ["words", "chars"] },
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
